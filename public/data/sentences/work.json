    {
      "id": "work-004",
      "tags": ["meeting", "time"],
      "text": {
        "en": "We have a meeting at two.",
        "fr": "On a une réunion à deux heures.",
        "es": "Tenemos una reunión a las dos.",
        "it": "Abbiamo una riunione alle due.",
        "pt": "Temos uma reunião às duas.",
        "de": "Wir haben um zwei ein Meeting.",
        "nl": "We hebben om twee uur een vergadering."
      }
    },
    {
      "id": "work-005",
      "tags": ["meeting", "question"],
      "text": {
        "en": "Can we reschedule the meeting?",
        "fr": "On peut reporter la réunion ?",
        "es": "¿Podemos cambiar la reunión?",
        "it": "Possiamo riprogrammare la riunione?",
        "pt": "Podemos remarcar a reunião?",
        "de": "Können wir das Meeting verschieben?",
        "nl": "Kunnen we de vergadering verzetten?"
      }
    },
    {
      "id": "work-006",
      "tags": ["meeting", "polite"],
      "text": {
        "en": "Could you send me the agenda?",
        "fr": "Peux-tu m’envoyer l’ordre du jour ?",
        "es": "¿Puedes enviarme el orden del día?",
        "it": "Puoi mandarmi l’ordine del giorno?",
