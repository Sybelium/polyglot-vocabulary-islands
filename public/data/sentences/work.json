        "de": "Kannst du mir die Agenda schicken?",
        "nl": "Kun je me de agenda sturen?"
      }
    },
    {
      "id": "work-007",
      "tags": ["email", "polite"],
      "text": {
        "en": "I'll send you an email.",
        "fr": "Je t’envoie un e-mail.",
