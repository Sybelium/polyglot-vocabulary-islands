    {"id":"conf-001","sentenceId":"conf-001","order":1,"tags":["disagreement"],"text":"Je vois les choses différemment.","englishReference":"I see it differently.","start":0,"end":2.784,"duration":2.784},
    {"id":"conf-002","sentenceId":"conf-002","order":2,"tags":["disagreement"],"text":"Je comprends ton point de vue, mais j’ai une opinion différente.","englishReference":"I understand your point, but I have a different opinion.","start":3.534,"end":8.406,"duration":4.872},
    {"id":"conf-003","sentenceId":"conf-003","order":3,"tags":["clarification"],"text":"Laisse-moi expliquer ma position.","englishReference":"Let me explain my position.","start":9.156,"end":12.444,"duration":3.288},
