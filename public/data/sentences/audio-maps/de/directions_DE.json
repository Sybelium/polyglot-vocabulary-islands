    {"id":"direc-002","sentenceId":"direc-002","order":2,"tags":["question","travel"],"text":"Wo ist die nächste Bushaltestelle?","englishReference":"Where is the nearest bus stop?","start":3.222,"end":6.558,"duration":3.336},
    {"id":"direc-003","sentenceId":"direc-003","order":3,"tags":["question","travel"],"text":"Wie komme ich ins Stadtzentrum?","englishReference":"How do I get to the city center?","start":7.308,"end":10.38,"duration":3.072},
    {"id":"direc-004","sentenceId":"direc-004","order":4,"tags":["basic","answer"],"text":"Gehen Sie geradeaus.","englishReference":"Go straight ahead.","start":11.13,"end":13.794,"duration":2.664},
