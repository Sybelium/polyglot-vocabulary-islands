    {"id":"direc-006","sentenceId":"direc-006","order":6,"tags":["basic","answer"],"text":"Biegen Sie rechts ab.","englishReference":"Turn right.","start":17.67,"end":20.094,"duration":2.424},
    {"id":"direc-007","sentenceId":"direc-007","order":7,"tags":["answer","travel"],"text":"Es ist links.","englishReference":"It's on the left.","start":20.844,"end":23.004,"duration":2.16},
    {"id":"direc-008","sentenceId":"direc-008","order":8,"tags":["answer","travel"],"text":"Es ist rechts.","englishReference":"It's on the right.","start":23.754,"end":25.842,"duration":2.088},
    {"id":"direc-009","sentenceId":"direc-009","order":9,"tags":["answer","travel"],"text":"Es ist in der Nähe.","englishReference":"It's near here.","start":26.592,"end":28.92,"duration":2.328},
    {"id":"direc-010","sentenceId":"direc-010","order":10,"tags":["answer","travel"],"text":"Es ist weit von hier.","englishReference":"It's far from here.","start":29.67,"end":32.19,"duration":2.52},
    {"id":"direc-011","sentenceId":"direc-011","order":11,"tags":["question","travel"],"text":"Ist es weit?","englishReference":"Is it far?","start":32.94,"end":34.98,"duration":2.04},
    {"id":"direc-012","sentenceId":"direc-012","order":12,"tags":["question","travel"],"text":"Ist es zu Fuß erreichbar?","englishReference":"Is it within walking distance?","start":35.73,"end":38.61,"duration":2.88},
    {"id":"direc-013","sentenceId":"direc-013","order":13,"tags":["question","travel"],"text":"Wie lange dauert es?","englishReference":"How long does it take?","start":39.36,"end":41.856,"duration":2.496},
    {"id":"direc-014","sentenceId":"direc-014","order":14,"tags":["answer","time"],"text":"Es dauert ungefähr zehn Minuten.","englishReference":"It takes about ten minutes.","start":42.606,"end":46.446,"duration":3.84},
    {"id":"direc-015","sentenceId":"direc-015","order":15,"tags":["travel"],"text":"Neben der Bank.","englishReference":"Next to the bank.","start":47.196,"end":49.38,"duration":2.184},
    {"id":"direc-016","sentenceId":"direc-016","order":16,"tags":["travel"],"text":"Gegenüber dem Supermarkt.","englishReference":"Opposite the supermarket.","start":50.13,"end":53.154,"duration":3.024},
    {"id":"direc-017","sentenceId":"direc-017","order":17,"tags":["travel"],"text":"An der Ecke.","englishReference":"At the corner.","start":53.904,"end":55.944,"duration":2.04},
    {"id":"direc-018","sentenceId":"direc-018","order":18,"tags":["question","travel"],"text":"Welcher Bus fährt zum Flughafen?","englishReference":"Which bus goes to the airport?","start":56.694,"end":60.15,"duration":3.456},
    {"id":"direc-019","sentenceId":"direc-019","order":19,"tags":["question","travel"],"text":"Wo kann ich ein Ticket kaufen?","englishReference":"Where can I buy a ticket?","start":60.9,"end":63.924,"duration":3.024},
    {"id":"direc-020","sentenceId":"direc-020","order":20,"tags":["repair","polite"],"text":"Können Sie es mir auf der Karte zeigen?","englishReference":"Can you show me on the map?","start":64.674,"end":68.178,"duration":3.504},
    {"id":"direc-021","sentenceId":"direc-021","order":21,"tags":["repair"],"text":"Ich habe mich verlaufen.","englishReference":"I am lost.","start":68.928,"end":71.4,"duration":2.472},
    {"id":"direc-022","sentenceId":"direc-022","order":22,"tags":["emergency"],"text":"Ich brauche Hilfe.","englishReference":"I need help.","start":72.15,"end":74.55,"duration":2.4},
    {"id":"direc-023","sentenceId":"direc-023","order":23,"tags":["question","travel"],"text":"Ist das der richtige Weg?","englishReference":"Is this the right way?","start":75.3,"end":78.036,"duration":2.736},
