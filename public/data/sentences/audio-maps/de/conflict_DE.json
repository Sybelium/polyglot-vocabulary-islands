    {"id":"conf-010","sentenceId":"conf-010","order":10,"tags":["assertive"],"text":"Ich bleibe bei meiner Entscheidung.","englishReference":"I stand by my decision.","start":38.742,"end":41.67,"duration":2.928},
    {"id":"conf-011","sentenceId":"conf-011","order":11,"tags":["respect"],"text":"Ich respektiere deine Meinung.","englishReference":"I respect your opinion.","start":42.42,"end":45.54,"duration":3.12},
    {"id":"conf-012","sentenceId":"conf-012","order":12,"tags":["deescalation"],"text":"Lass uns uns auf die Lösung konzentrieren.","englishReference":"Let’s focus on solving the problem.","start":46.29,"end":50.25,"duration":3.96},
    {"id":"conf-013","sentenceId":"conf-013","order":13,"tags":["clarification"],"text":"Kannst du klarstellen, was du meinst?","englishReference":"Can you clarify what you mean?","start":51,"end":54.672,"duration":3.672},
