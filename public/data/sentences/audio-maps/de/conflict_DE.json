    {"id":"conf-001","sentenceId":"conf-001","order":1,"tags":["disagreement"],"text":"Ich sehe das anders.","englishReference":"I see it differently.","start":0,"end":2.496,"duration":2.496},
    {"id":"conf-002","sentenceId":"conf-002","order":2,"tags":["disagreement"],"text":"Ich verstehe deinen Standpunkt, aber ich habe eine andere Meinung.","englishReference":"I understand your point, but I have a different opinion.","start":3.246,"end":8.67,"duration":5.424},
    {"id":"conf-003","sentenceId":"conf-003","order":3,"tags":["clarification"],"text":"Lass mich meine Position erklären.","englishReference":"Let me explain my position.","start":9.42,"end":12.972,"duration":3.552},
    {"id":"conf-004","sentenceId":"conf-004","order":4,"tags":["boundary"],"text":"Damit fühle ich mich nicht wohl.","englishReference":"I’m not comfortable with that.","start":13.722,"end":16.674,"duration":2.952},
    {"id":"conf-005","sentenceId":"conf-005","order":5,"tags":["boundary"],"text":"Das funktioniert für mich nicht.","englishReference":"That doesn’t work for me.","start":17.424,"end":20.376,"duration":2.952},
    {"id":"conf-006","sentenceId":"conf-006","order":6,"tags":["assertive"],"text":"Ich brauche mehr Zeit, um darüber nachzudenken.","englishReference":"I need more time to think about it.","start":21.126,"end":25.614,"duration":4.488},
    {"id":"conf-007","sentenceId":"conf-007","order":7,"tags":["calm"],"text":"Lass uns das ruhig besprechen.","englishReference":"Let’s discuss this calmly.","start":26.364,"end":29.556,"duration":3.192},
