    {"id":"direc-001","sentenceId":"direc-001","order":1,"tags":["question","basic","travel"],"text":"Onde fica a estação?","englishReference":"Where is the train station?","start":0,"end":2.616,"duration":2.616},
    {"id":"direc-002","sentenceId":"direc-002","order":2,"tags":["question","travel"],"text":"Onde fica a paragem de autocarro mais próxima?","englishReference":"Where is the nearest bus stop?","start":3.366,"end":7.47,"duration":4.104},
    {"id":"direc-003","sentenceId":"direc-003","order":3,"tags":["question","travel"],"text":"Como chego ao centro?","englishReference":"How do I get to the city center?","start":8.22,"end":10.812,"duration":2.592},
    {"id":"direc-004","sentenceId":"direc-004","order":4,"tags":["basic","answer"],"text":"Siga em frente.","englishReference":"Go straight ahead.","start":11.562,"end":14.13,"duration":2.568},
    {"id":"direc-005","sentenceId":"direc-005","order":5,"tags":["basic","answer"],"text":"Vire à esquerda.","englishReference":"Turn left.","start":14.88,"end":17.352,"duration":2.472},
    {"id":"direc-006","sentenceId":"direc-006","order":6,"tags":["basic","answer"],"text":"Vire à direita.","englishReference":"Turn right.","start":18.102,"end":20.598,"duration":2.496},
    {"id":"direc-007","sentenceId":"direc-007","order":7,"tags":["answer","travel"],"text":"Fica à esquerda.","englishReference":"It's on the left.","start":21.348,"end":23.796,"duration":2.448},
    {"id":"direc-008","sentenceId":"direc-008","order":8,"tags":["answer","travel"],"text":"Fica à direita.","englishReference":"It's on the right.","start":24.546,"end":27.042,"duration":2.496},
    {"id":"direc-009","sentenceId":"direc-009","order":9,"tags":["answer","travel"],"text":"Fica perto daqui.","englishReference":"It's near here.","start":27.792,"end":30.432,"duration":2.64},
    {"id":"direc-010","sentenceId":"direc-010","order":10,"tags":["answer","travel"],"text":"Fica longe daqui.","englishReference":"It's far from here.","start":31.182,"end":33.798,"duration":2.616},
    {"id":"direc-011","sentenceId":"direc-011","order":11,"tags":["question","travel"],"text":"É longe?","englishReference":"Is it far?","start":34.548,"end":36.492,"duration":1.944},
    {"id":"direc-012","sentenceId":"direc-012","order":12,"tags":["question","travel"],"text":"Fica a uma curta distância a pé?","englishReference":"Is it within walking distance?","start":37.242,"end":40.434,"duration":3.192},
    {"id":"direc-013","sentenceId":"direc-013","order":13,"tags":["question","travel"],"text":"Quanto tempo demora?","englishReference":"How long does it take?","start":41.184,"end":43.68,"duration":2.496},
    {"id":"direc-014","sentenceId":"direc-014","order":14,"tags":["answer","time"],"text":"Demora cerca de dez minutos.","englishReference":"It takes about ten minutes.","start":44.43,"end":48.15,"duration":3.72},
    {"id":"direc-015","sentenceId":"direc-015","order":15,"tags":["travel"],"text":"Ao lado do banco.","englishReference":"Next to the bank.","start":48.9,"end":51.444,"duration":2.544},
    {"id":"direc-016","sentenceId":"direc-016","order":16,"tags":["travel"],"text":"Em frente ao supermercado.","englishReference":"Opposite the supermarket.","start":52.194,"end":55.554,"duration":3.36},
    {"id":"direc-017","sentenceId":"direc-017","order":17,"tags":["travel"],"text":"Na esquina.","englishReference":"At the corner.","start":56.304,"end":58.56,"duration":2.256},
    {"id":"direc-018","sentenceId":"direc-018","order":18,"tags":["question","travel"],"text":"Que autocarro vai para o aeroporto?","englishReference":"Which bus goes to the airport?","start":59.31,"end":62.886,"duration":3.576},
    {"id":"direc-019","sentenceId":"direc-019","order":19,"tags":["question","travel"],"text":"Onde posso comprar um bilhete?","englishReference":"Where can I buy a ticket?","start":63.636,"end":66.564,"duration":2.928},
    {"id":"direc-020","sentenceId":"direc-020","order":20,"tags":["repair","polite"],"text":"Pode mostrar-me no mapa?","englishReference":"Can you show me on the map?","start":67.314,"end":70.026,"duration":2.712},
    {"id":"direc-021","sentenceId":"direc-021","order":21,"tags":["repair"],"text":"Estou perdido/a.","englishReference":"I am lost.","start":70.776,"end":73.2,"duration":2.424},
    {"id":"direc-022","sentenceId":"direc-022","order":22,"tags":["emergency"],"text":"Preciso de ajuda.","englishReference":"I need help.","start":73.95,"end":76.614,"duration":2.664},
    {"id":"direc-023","sentenceId":"direc-023","order":23,"tags":["question","travel"],"text":"É o caminho certo?","englishReference":"Is this the right way?","start":77.364,"end":79.86,"duration":2.496},
    {"id":"direc-024","sentenceId":"direc-024","order":24,"tags":["travel"],"text":"Passe os semáforos.","englishReference":"Go past the traffic lights.","start":80.61,"end":83.466,"duration":2.856},
    {"id":"direc-025","sentenceId":"direc-025","order":25,"tags":["travel"],"text":"Fica do outro lado da rua.","englishReference":"It's across the street.","start":84.216,"end":87.432,"duration":3.216}
