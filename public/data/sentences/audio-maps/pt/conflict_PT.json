    {"id":"conf-001","sentenceId":"conf-001","order":1,"tags":["disagreement"],"text":"Vejo a situação de forma diferente.","englishReference":"I see it differently.","start":0,"end":3.912,"duration":3.912},
    {"id":"conf-002","sentenceId":"conf-002","order":2,"tags":["disagreement"],"text":"Compreendo o teu ponto de vista, mas tenho uma opinião diferente.","englishReference":"I understand your point, but I have a different opinion.","start":4.662,"end":9.678,"duration":5.016},
    {"id":"conf-003","sentenceId":"conf-003","order":3,"tags":["clarification"],"text":"Deixa-me explicar a minha posição.","englishReference":"Let me explain my position.","start":10.428,"end":13.86,"duration":3.432},
    {"id":"conf-004","sentenceId":"conf-004","order":4,"tags":["boundary"],"text":"Não me sinto confortável com isso.","englishReference":"I’m not comfortable with that.","start":14.61,"end":18.186,"duration":3.576},
    {"id":"conf-005","sentenceId":"conf-005","order":5,"tags":["boundary"],"text":"Isso não funciona para mim.","englishReference":"That doesn’t work for me.","start":18.936,"end":21.96,"duration":3.024},
