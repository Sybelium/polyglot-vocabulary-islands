    {"id":"direc-001","sentenceId":"direc-001","order":1,"tags":["question","basic","travel"],"text":"Dov'è la stazione?","englishReference":"Where is the train station?","start":0,"end":1.728,"duration":1.728},
    {"id":"direc-002","sentenceId":"direc-002","order":2,"tags":["question","travel"],"text":"Dov'è la fermata dell'autobus più vicina?","englishReference":"Where is the nearest bus stop?","start":2.478,"end":5.574,"duration":3.096},
    {"id":"direc-003","sentenceId":"direc-003","order":3,"tags":["question","travel"],"text":"Come arrivo al centro?","englishReference":"How do I get to the city center?","start":6.324,"end":8.052,"duration":1.728},
    {"id":"direc-004","sentenceId":"direc-004","order":4,"tags":["basic","answer"],"text":"Vai dritto.","englishReference":"Go straight ahead.","start":8.802,"end":10.146,"duration":1.344},
    {"id":"direc-005","sentenceId":"direc-005","order":5,"tags":["basic","answer"],"text":"Gira a sinistra.","englishReference":"Turn left.","start":10.896,"end":12.48,"duration":1.584},
    {"id":"direc-006","sentenceId":"direc-006","order":6,"tags":["basic","answer"],"text":"Gira a destra.","englishReference":"Turn right.","start":13.23,"end":14.718,"duration":1.488},
    {"id":"direc-007","sentenceId":"direc-007","order":7,"tags":["answer","travel"],"text":"È sulla sinistra.","englishReference":"It's on the left.","start":15.468,"end":17.1,"duration":1.632},
    {"id":"direc-008","sentenceId":"direc-008","order":8,"tags":["answer","travel"],"text":"È sulla destra.","englishReference":"It's on the right.","start":17.85,"end":19.434,"duration":1.584},
    {"id":"direc-009","sentenceId":"direc-009","order":9,"tags":["answer","travel"],"text":"È vicino a qui.","englishReference":"It's near here.","start":20.184,"end":21.768,"duration":1.584},
    {"id":"direc-010","sentenceId":"direc-010","order":10,"tags":["answer","travel"],"text":"È lontano da qui.","englishReference":"It's far from here.","start":22.518,"end":24.102,"duration":1.584},
    {"id":"direc-011","sentenceId":"direc-011","order":11,"tags":["question","travel"],"text":"È lontano?","englishReference":"Is it far?","start":24.852,"end":26.124,"duration":1.272},
    {"id":"direc-012","sentenceId":"direc-012","order":12,"tags":["question","travel"],"text":"È raggiungibile a piedi?","englishReference":"Is it within walking distance?","start":26.874,"end":28.866,"duration":1.992},
    {"id":"direc-013","sentenceId":"direc-013","order":13,"tags":["question","travel"],"text":"Quanto tempo ci vuole?","englishReference":"How long does it take?","start":29.616,"end":31.416,"duration":1.8},
    {"id":"direc-014","sentenceId":"direc-014","order":14,"tags":["answer","time"],"text":"Ci vogliono circa dieci minuti.","englishReference":"It takes about ten minutes.","start":32.166,"end":34.662,"duration":2.496},
    {"id":"direc-015","sentenceId":"direc-015","order":15,"tags":["travel"],"text":"Accanto alla banca.","englishReference":"Next to the bank.","start":35.412,"end":37.116,"duration":1.704},
    {"id":"direc-016","sentenceId":"direc-016","order":16,"tags":["travel"],"text":"Di fronte al supermercato.","englishReference":"Opposite the supermarket.","start":37.866,"end":40.194,"duration":2.328},
    {"id":"direc-017","sentenceId":"direc-017","order":17,"tags":["travel"],"text":"All'angolo.","englishReference":"At the corner.","start":40.944,"end":42.192,"duration":1.248},
    {"id":"direc-018","sentenceId":"direc-018","order":18,"tags":["question","travel"],"text":"Quale autobus va all'aeroporto?","englishReference":"Which bus goes to the airport?","start":42.942,"end":45.462,"duration":2.52},
    {"id":"direc-019","sentenceId":"direc-019","order":19,"tags":["question","travel"],"text":"Dove posso comprare un biglietto?","englishReference":"Where can I buy a ticket?","start":46.212,"end":48.612,"duration":2.4},
