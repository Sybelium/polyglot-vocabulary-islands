    {"id":"direc-021","sentenceId":"direc-021","order":21,"tags":["repair"],"text":"Mi sono perso/a.","englishReference":"I am lost.","start":52.152,"end":53.688,"duration":1.536},
    {"id":"direc-022","sentenceId":"direc-022","order":22,"tags":["emergency"],"text":"Ho bisogno di aiuto.","englishReference":"I need help.","start":54.438,"end":56.286,"duration":1.848},
    {"id":"direc-023","sentenceId":"direc-023","order":23,"tags":["question","travel"],"text":"È la strada giusta?","englishReference":"Is this the right way?","start":57.036,"end":58.692,"duration":1.656},
