    {"id":"emer-002","sentenceId":"emer-002","order":2,"tags":["emergency","urgent"],"text":"Chiami la polizia!","englishReference":"Call the police!","start":1.974,"end":3.678,"duration":1.704},
    {"id":"emer-003","sentenceId":"emer-003","order":3,"tags":["emergency","urgent"],"text":"Chiami un’ambulanza!","englishReference":"Call an ambulance!","start":4.428,"end":6.252,"duration":1.824},
    {"id":"emer-004","sentenceId":"emer-004","order":4,"tags":["emergency","urgent"],"text":"Chiami i vigili del fuoco!","englishReference":"Call the fire department!","start":7.002,"end":9.114,"duration":2.112},
    {"id":"emer-005","sentenceId":"emer-005","order":5,"tags":["emergency"],"text":"C’è stato un incidente.","englishReference":"There has been an accident.","start":9.864,"end":11.808,"duration":1.944},
    {"id":"emer-006","sentenceId":"emer-006","order":6,"tags":["emergency"],"text":"Qualcuno è ferito.","englishReference":"Someone is injured.","start":12.558,"end":14.334,"duration":1.776},
    {"id":"emer-007","sentenceId":"emer-007","order":7,"tags":["emergency"],"text":"Sono stato/a derubato/a.","englishReference":"I have been robbed.","start":15.084,"end":17.268,"duration":2.184},
    {"id":"emer-008","sentenceId":"emer-008","order":8,"tags":["emergency"],"text":"Mi hanno rubato il portafoglio.","englishReference":"My wallet was stolen.","start":18.018,"end":20.13,"duration":2.112},
    {"id":"emer-009","sentenceId":"emer-009","order":9,"tags":["emergency"],"text":"Mi hanno rubato il passaporto.","englishReference":"My passport was stolen.","start":20.88,"end":23.064,"duration":2.184},
    {"id":"emer-010","sentenceId":"emer-010","order":10,"tags":["emergency"],"text":"Ho perso il telefono.","englishReference":"I lost my phone.","start":23.814,"end":25.734,"duration":1.92},
    {"id":"emer-011","sentenceId":"emer-011","order":11,"tags":["emergency","urgent"],"text":"Sono in pericolo.","englishReference":"I am in danger.","start":26.484,"end":28.068,"duration":1.584},
    {"id":"emer-012","sentenceId":"emer-012","order":12,"tags":["emergency","urgent"],"text":"Mi lasci in pace!","englishReference":"Leave me alone!","start":28.818,"end":30.546,"duration":1.728},
    {"id":"emer-013","sentenceId":"emer-013","order":13,"tags":["emergency"],"text":"Ho bisogno di aiuto immediatamente.","englishReference":"I need help immediately.","start":31.296,"end":34.104,"duration":2.808},
    {"id":"emer-014","sentenceId":"emer-014","order":14,"tags":["emergency"],"text":"Dov’è la stazione di polizia più vicina?","englishReference":"Where is the nearest police station?","start":34.854,"end":37.83,"duration":2.976},
    {"id":"emer-015","sentenceId":"emer-015","order":15,"tags":["emergency"],"text":"Devo denunciare un furto.","englishReference":"I need to report a theft.","start":38.58,"end":40.764,"duration":2.184},
    {"id":"emer-016","sentenceId":"emer-016","order":16,"tags":["emergency"],"text":"È successo qui.","englishReference":"It happened here.","start":41.514,"end":43.146,"duration":1.632},
    {"id":"emer-017","sentenceId":"emer-017","order":17,"tags":["emergency"],"text":"È scappato da quella parte.","englishReference":"He ran that way.","start":43.896,"end":46.032,"duration":2.136},
    {"id":"emer-018","sentenceId":"emer-018","order":18,"tags":["emergency"],"text":"Non mi sento al sicuro.","englishReference":"I don't feel safe.","start":46.782,"end":48.654,"duration":1.872},
    {"id":"emer-019","sentenceId":"emer-019","order":19,"tags":["emergency"],"text":"Rimanga con me, per favore.","englishReference":"Please stay with me.","start":49.404,"end":51.828,"duration":2.424},
    {"id":"emer-020","sentenceId":"emer-020","order":20,"tags":["emergency"],"text":"Può chiamare aiuto?","englishReference":"Can you call for help?","start":52.578,"end":54.114,"duration":1.536}
