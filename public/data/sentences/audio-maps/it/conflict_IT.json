    {"id":"conf-001","sentenceId":"conf-001","order":1,"tags":["disagreement"],"text":"La vedo in modo diverso.","englishReference":"I see it differently.","start":0,"end":2.016,"duration":2.016},
    {"id":"conf-002","sentenceId":"conf-002","order":2,"tags":["disagreement"],"text":"Capisco il tuo punto di vista, ma ho un'opinione diversa.","englishReference":"I understand your point, but I have a different opinion.","start":2.766,"end":6.798,"duration":4.032},
    {"id":"conf-003","sentenceId":"conf-003","order":3,"tags":["clarification"],"text":"Lascia che spieghi la mia posizione.","englishReference":"Let me explain my position.","start":7.548,"end":10.236,"duration":2.688},
    {"id":"conf-004","sentenceId":"conf-004","order":4,"tags":["boundary"],"text":"Non mi sento a mio agio con questo.","englishReference":"I’m not comfortable with that.","start":10.986,"end":13.554,"duration":2.568},
    {"id":"conf-005","sentenceId":"conf-005","order":5,"tags":["boundary"],"text":"Questo non va bene per me.","englishReference":"That doesn’t work for me.","start":14.304,"end":16.296,"duration":1.992},
    {"id":"conf-006","sentenceId":"conf-006","order":6,"tags":["assertive"],"text":"Ho bisogno di più tempo per pensarci.","englishReference":"I need more time to think about it.","start":17.046,"end":19.902,"duration":2.856},
    {"id":"conf-007","sentenceId":"conf-007","order":7,"tags":["calm"],"text":"Parliamone con calma.","englishReference":"Let’s discuss this calmly.","start":20.652,"end":22.572,"duration":1.92},
    {"id":"conf-008","sentenceId":"conf-008","order":8,"tags":["solution"],"text":"Quale soluzione proponi?","englishReference":"What solution would you suggest?","start":23.322,"end":25.482,"duration":2.16},
