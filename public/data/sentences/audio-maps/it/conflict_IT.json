    {"id":"conf-010","sentenceId":"conf-010","order":10,"tags":["assertive"],"text":"Mantengo la mia decisione.","englishReference":"I stand by my decision.","start":29.334,"end":31.542,"duration":2.208},
    {"id":"conf-011","sentenceId":"conf-011","order":11,"tags":["respect"],"text":"Rispetto la tua opinione.","englishReference":"I respect your opinion.","start":32.292,"end":34.356,"duration":2.064},
