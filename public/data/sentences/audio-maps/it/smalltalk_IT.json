    {"id":"talk-005","sentenceId":"talk-005","order":5,"tags":["basic"],"text":"Piacere di vederti.","englishReference":"Nice to see you.","start":10.08,"end":11.808,"duration":1.728},
    {"id":"talk-006","sentenceId":"talk-006","order":6,"tags":["polite"],"text":"Com’è andata la tua giornata?","englishReference":"How was your day?","start":12.558,"end":14.598,"duration":2.04},
