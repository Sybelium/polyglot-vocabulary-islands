    {"id":"talk-008","sentenceId":"talk-008","order":8,"tags":["answer"],"text":"È stata una giornata intensa.","englishReference":"It was busy.","start":17.514,"end":19.89,"duration":2.376},
    {"id":"talk-009","sentenceId":"talk-009","order":9,"tags":["question","basic"],"text":"Di dove sei?","englishReference":"Where are you from?","start":20.64,"end":22.08,"duration":1.44},
    {"id":"talk-010","sentenceId":"talk-010","order":10,"tags":["answer"],"text":"Sono del Belgio.","englishReference":"I'm from Belgium.","start":22.83,"end":24.366,"duration":1.536},
    {"id":"talk-011","sentenceId":"talk-011","order":11,"tags":["question"],"text":"Abiti qui?","englishReference":"Do you live here?","start":25.116,"end":26.316,"duration":1.2},
    {"id":"talk-012","sentenceId":"talk-012","order":12,"tags":["answer"],"text":"Sì, abito qui vicino.","englishReference":"Yes, I live nearby.","start":27.066,"end":29.466,"duration":2.4},
    {"id":"talk-013","sentenceId":"talk-013","order":13,"tags":["question"],"text":"Che lavoro fai?","englishReference":"What do you do?","start":30.216,"end":31.536,"duration":1.32},
    {"id":"talk-014","sentenceId":"talk-014","order":14,"tags":["answer"],"text":"Studio.","englishReference":"I study.","start":32.286,"end":33.39,"duration":1.104},
    {"id":"talk-015","sentenceId":"talk-015","order":15,"tags":["answer"],"text":"Lavoro nell’informatica.","englishReference":"I work in IT.","start":34.14,"end":36.3,"duration":2.16},
    {"id":"talk-016","sentenceId":"talk-016","order":16,"tags":["question","languages"],"text":"Parli inglese?","englishReference":"Do you speak English?","start":37.05,"end":38.49,"duration":1.44},
    {"id":"talk-017","sentenceId":"talk-017","order":17,"tags":["answer","languages"],"text":"Un po’.","englishReference":"A little.","start":39.24,"end":40.176,"duration":0.936},
    {"id":"talk-018","sentenceId":"talk-018","order":18,"tags":["question","languages"],"text":"Sto imparando la tua lingua.","englishReference":"I'm learning your language.","start":40.926,"end":43.086,"duration":2.16},
    {"id":"talk-019","sentenceId":"talk-019","order":19,"tags":["polite","languages"],"text":"Puoi parlare un po’ più lentamente?","englishReference":"Could you speak a bit more slowly?","start":43.836,"end":46.236,"duration":2.4},
    {"id":"talk-020","sentenceId":"talk-020","order":20,"tags":["question","plans"],"text":"Che fai questo weekend?","englishReference":"What are you doing this weekend?","start":46.986,"end":48.69,"duration":1.704},
    {"id":"talk-021","sentenceId":"talk-021","order":21,"tags":["answer","plans"],"text":"Non lo so ancora.","englishReference":"I don't know yet.","start":49.44,"end":51.024,"duration":1.584},
    {"id":"talk-022","sentenceId":"talk-022","order":22,"tags":["answer","plans"],"text":"Vedo degli amici.","englishReference":"I'm meeting some friends.","start":51.774,"end":53.934,"duration":2.16},
    {"id":"talk-023","sentenceId":"talk-023","order":23,"tags":["question","smalltalk"],"text":"Ti piace qui?","englishReference":"Do you like it here?","start":54.684,"end":55.956,"duration":1.272},
    {"id":"talk-024","sentenceId":"talk-024","order":24,"tags":["answer","smalltalk"],"text":"Sì, è davvero bello.","englishReference":"Yes, it's really nice.","start":56.706,"end":58.866,"duration":2.16},
    {"id":"talk-025","sentenceId":"talk-025","order":25,"tags":["polite"],"text":"È stato un piacere parlare con te.","englishReference":"It was nice talking to you.","start":59.616,"end":62.184,"duration":2.568}
