    {"id":"talk-002","sentenceId":"talk-002","order":2,"tags":["answer","basic"],"text":"Sto bene, grazie. E tu?","englishReference":"I'm fine, thanks. And you?","start":1.95,"end":4.83,"duration":2.88},
