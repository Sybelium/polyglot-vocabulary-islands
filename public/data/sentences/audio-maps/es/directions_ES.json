    {"id":"direc-006","sentenceId":"direc-006","order":6,"tags":["basic","answer"],"text":"Gire a la derecha.","englishReference":"Turn right.","start":17.31,"end":19.686,"duration":2.376},
    {"id":"direc-007","sentenceId":"direc-007","order":7,"tags":["answer","travel"],"text":"Está a la izquierda.","englishReference":"It's on the left.","start":20.436,"end":22.884,"duration":2.448},
