    {"id":"direc-009","sentenceId":"direc-009","order":9,"tags":["answer","travel"],"text":"Está cerca de aquí.","englishReference":"It's near here.","start":26.808,"end":29.304,"duration":2.496},
    {"id":"direc-010","sentenceId":"direc-010","order":10,"tags":["answer","travel"],"text":"Está lejos de aquí.","englishReference":"It's far from here.","start":30.054,"end":32.526,"duration":2.472},
    {"id":"direc-011","sentenceId":"direc-011","order":11,"tags":["question","travel"],"text":"¿Está lejos?","englishReference":"Is it far?","start":33.276,"end":35.412,"duration":2.136},
    {"id":"direc-012","sentenceId":"direc-012","order":12,"tags":["question","travel"],"text":"¿Está a poca distancia a pie?","englishReference":"Is it within walking distance?","start":36.162,"end":39.162,"duration":3},
