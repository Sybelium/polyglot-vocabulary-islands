    {"id":"direc-002","sentenceId":"direc-002","order":2,"tags":["question","travel"],"text":"¿Dónde está la parada de autobús más cercana?","englishReference":"Where is the nearest bus stop?","start":3.414,"end":7.35,"duration":3.936},
    {"id":"direc-003","sentenceId":"direc-003","order":3,"tags":["question","travel"],"text":"¿Cómo llego al centro?","englishReference":"How do I get to the city center?","start":8.1,"end":10.524,"duration":2.424},
    {"id":"direc-004","sentenceId":"direc-004","order":4,"tags":["basic","answer"],"text":"Siga recto.","englishReference":"Go straight ahead.","start":11.274,"end":13.41,"duration":2.136},
