    {"id":"nego-001","sentenceId":"nego-001","order":1,"tags":["proposal"],"text":"Laat me een voorstel doen.","englishReference":"Let me make a proposal.","start":0,"end":2.952,"duration":2.952},
    {"id":"nego-002","sentenceId":"nego-002","order":2,"tags":["proposal"],"text":"Dit stel ik voor.","englishReference":"Here is what I suggest.","start":3.702,"end":6.27,"duration":2.568},
    {"id":"nego-003","sentenceId":"nego-003","order":3,"tags":["conditions"],"text":"Onder deze voorwaarden kunnen we doorgaan.","englishReference":"Under these conditions, we can move forward.","start":7.02,"end":10.956,"duration":3.936},
    {"id":"nego-004","sentenceId":"nego-004","order":4,"tags":["clarification"],"text":"Kunt u uw verwachtingen verduidelijken?","englishReference":"Could you clarify your expectations?","start":11.706,"end":15.066,"duration":3.36},
