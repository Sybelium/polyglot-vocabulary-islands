    {"id":"nego-006","sentenceId":"nego-006","order":6,"tags":["pricing"],"text":"Kunt u een betere prijs aanbieden?","englishReference":"Can you offer a better rate?","start":19.878,"end":23.19,"duration":3.312},
    {"id":"nego-007","sentenceId":"nego-007","order":7,"tags":["compromise"],"text":"We zijn bereid een compromis te sluiten.","englishReference":"We are willing to compromise.","start":23.94,"end":27.756,"duration":3.816},
    {"id":"nego-008","sentenceId":"nego-008","order":8,"tags":["timeline"],"text":"We hebben een duidelijke planning nodig.","englishReference":"We need a clear timeline.","start":28.506,"end":32.106,"duration":3.6},
