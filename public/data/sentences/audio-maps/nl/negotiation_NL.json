    {"id":"nego-010","sentenceId":"nego-010","order":10,"tags":["agreement"],"text":"We hebben een overeenkomst.","englishReference":"We have an agreement.","start":36.318,"end":39.342,"duration":3.024},
    {"id":"nego-011","sentenceId":"nego-011","order":11,"tags":["formal"],"text":"Laten we dit schriftelijk vastleggen.","englishReference":"Let’s put this in writing.","start":40.092,"end":43.716,"duration":3.624},
    {"id":"nego-012","sentenceId":"nego-012","order":12,"tags":["formal"],"text":"We zullen het contract zorgvuldig bekijken.","englishReference":"We will review the contract carefully.","start":44.466,"end":48.498,"duration":4.032},
