    {"id":"direc-001","sentenceId":"direc-001","order":1,"tags":["question","basic","travel"],"text":"Waar is het station?","englishReference":"Where is the train station?","start":0,"end":2.616,"duration":2.616},
    {"id":"direc-002","sentenceId":"direc-002","order":2,"tags":["question","travel"],"text":"Waar is de dichtstbijzijnde bushalte?","englishReference":"Where is the nearest bus stop?","start":3.366,"end":7.086,"duration":3.72},
    {"id":"direc-003","sentenceId":"direc-003","order":3,"tags":["question","travel"],"text":"Hoe kom ik in het centrum?","englishReference":"How do I get to the city center?","start":7.836,"end":10.644,"duration":2.808},
    {"id":"direc-004","sentenceId":"direc-004","order":4,"tags":["basic","answer"],"text":"Ga rechtdoor.","englishReference":"Go straight ahead.","start":11.394,"end":13.698,"duration":2.304},
    {"id":"direc-005","sentenceId":"direc-005","order":5,"tags":["basic","answer"],"text":"Sla linksaf.","englishReference":"Turn left.","start":14.448,"end":16.872,"duration":2.424},
    {"id":"direc-006","sentenceId":"direc-006","order":6,"tags":["basic","answer"],"text":"Sla rechtsaf.","englishReference":"Turn right.","start":17.622,"end":20.094,"duration":2.472},
    {"id":"direc-007","sentenceId":"direc-007","order":7,"tags":["answer","travel"],"text":"Het is links.","englishReference":"It's on the left.","start":20.844,"end":22.98,"duration":2.136},
    {"id":"direc-008","sentenceId":"direc-008","order":8,"tags":["answer","travel"],"text":"Het is rechts.","englishReference":"It's on the right.","start":23.73,"end":25.89,"duration":2.16},
    {"id":"direc-009","sentenceId":"direc-009","order":9,"tags":["answer","travel"],"text":"Het is dichtbij.","englishReference":"It's near here.","start":26.64,"end":28.92,"duration":2.28},
    {"id":"direc-010","sentenceId":"direc-010","order":10,"tags":["answer","travel"],"text":"Het is ver van hier.","englishReference":"It's far from here.","start":29.67,"end":32.31,"duration":2.64},
    {"id":"direc-011","sentenceId":"direc-011","order":11,"tags":["question","travel"],"text":"Is het ver?","englishReference":"Is it far?","start":33.06,"end":35.004,"duration":1.944},
    {"id":"direc-012","sentenceId":"direc-012","order":12,"tags":["question","travel"],"text":"Is het op loopafstand?","englishReference":"Is it within walking distance?","start":35.754,"end":38.562,"duration":2.808},
    {"id":"direc-013","sentenceId":"direc-013","order":13,"tags":["question","travel"],"text":"Hoe lang duurt het?","englishReference":"How long does it take?","start":39.312,"end":41.664,"duration":2.352},
    {"id":"direc-014","sentenceId":"direc-014","order":14,"tags":["answer","time"],"text":"Het duurt ongeveer tien minuten.","englishReference":"It takes about ten minutes.","start":42.414,"end":45.846,"duration":3.432},
    {"id":"direc-015","sentenceId":"direc-015","order":15,"tags":["travel"],"text":"Naast de bank.","englishReference":"Next to the bank.","start":46.596,"end":48.972,"duration":2.376},
    {"id":"direc-016","sentenceId":"direc-016","order":16,"tags":["travel"],"text":"Tegenover de supermarkt.","englishReference":"Opposite the supermarket.","start":49.722,"end":52.794,"duration":3.072},
    {"id":"direc-017","sentenceId":"direc-017","order":17,"tags":["travel"],"text":"Op de hoek.","englishReference":"At the corner.","start":53.544,"end":55.416,"duration":1.872},
    {"id":"direc-018","sentenceId":"direc-018","order":18,"tags":["question","travel"],"text":"Welke bus gaat naar de luchthaven?","englishReference":"Which bus goes to the airport?","start":56.166,"end":59.79,"duration":3.624},
    {"id":"direc-019","sentenceId":"direc-019","order":19,"tags":["question","travel"],"text":"Waar kan ik een kaartje kopen?","englishReference":"Where can I buy a ticket?","start":60.54,"end":63.66,"duration":3.12},
    {"id":"direc-020","sentenceId":"direc-020","order":20,"tags":["repair","polite"],"text":"Kunt u het op de kaart aanwijzen?","englishReference":"Can you show me on the map?","start":64.41,"end":67.626,"duration":3.216},
    {"id":"direc-021","sentenceId":"direc-021","order":21,"tags":["repair"],"text":"Ik ben verdwaald.","englishReference":"I am lost.","start":68.376,"end":70.824,"duration":2.448},
    {"id":"direc-022","sentenceId":"direc-022","order":22,"tags":["emergency"],"text":"Ik heb hulp nodig.","englishReference":"I need help.","start":71.574,"end":74.262,"duration":2.688},
    {"id":"direc-023","sentenceId":"direc-023","order":23,"tags":["question","travel"],"text":"Is dit de juiste weg?","englishReference":"Is this the right way?","start":75.012,"end":77.796,"duration":2.784},
    {"id":"direc-024","sentenceId":"direc-024","order":24,"tags":["travel"],"text":"Ga voorbij het verkeerslicht.","englishReference":"Go past the traffic lights.","start":78.546,"end":81.954,"duration":3.408},
    {"id":"direc-025","sentenceId":"direc-025","order":25,"tags":["travel"],"text":"Het is aan de overkant van de straat.","englishReference":"It's across the street.","start":82.704,"end":86.28,"duration":3.576}
